package com.arval.blm.core.application.service

import io.mockk.*
import org.junit.jupiter.api.*
import java.time.Instant
import java.util.stream.IntStream
import kotlin.test.assertEquals
import kotlin.test.assertFailsWith

// --- Import des modèles ---
import com.arval.blm.core.domain.model.*
import com.arval.blm.core.domain.spi.*

@TestInstance(TestInstance.Lifecycle.PER_CLASS)
class ImportCustomerServiceTest {

    // --- Mocks ---
    private val referenceIdFactory: ReferenceIdFactory = mockk()
    private val clockProvider: ClockProvider = mockk()
    private val crmClsCustomerDataRepositorySpi: CrmClsCustomerDataRepositorySpi = mockk()
    private val batchRepositorySpi: BatchRepositoryForContactsSpi = mockk()
    private val crmCustomerProviderSpi: CrmCustomerProviderSpi = mockk()
    private val clsProviderSpi: ClsProviderSpi = mockk()
    private val odsProviderSpi: OdsProviderSpi = mockk(relaxed = true)
    private val countryPrefixSpi: CountryPrefixSpi = mockk(relaxed = true)
    private val recordStepEventRepositorySpi: RecordStepEventRepositorySpi = mockk(relaxed = true)

    // --- Données de test ---
    private val contactsToCreate = IntStream.range(0, 2).mapToObj { i ->
        CustomerPayload(
            rowNumber = i,
            crmData = CrmData(
                title = "Dr.",
                salutation = "Dr.",
                prefLanguageComm = "French",
                gender = "Male",
                contactRole = "Driver",
                country = "GB",
                mainCountry = "GB"
            ),
            clsData = mapOf(),
            errorMessage = null
        )
    }.toList()

    private val batchReference = ReferenceId(value = "HVrA7jQziv")
    private val countryCodeUK = CountryCode(countryCode = "GB")
    private val newBatch = LoaderBatch(
        id = "AAAAA",
        reference = batchReference,
        fileName = "a-file-name.csv",
        triggeredBy = "u00001",
        countryCode = countryCodeUK,
        status = LoaderBatchStatus.RUNNING,
        startDate = Instant.MIN,
        endDate = Instant.MIN,
        totalContacts = contactsToCreate.size,
        type = LoaderBatchType.CONTACTS
    )

    // --- Service à tester ---
    private val importCustomersService = ImportCustomersService(
        referenceIdFactory = referenceIdFactory,
        clockProvider = clockProvider,
        crmClsCustomerDataRepositorySpi = crmClsCustomerDataRepositorySpi,
        batchRepositorySpi = batchRepositorySpi,
        crmCustomerProviderSpi = crmCustomerProviderSpi,
        recordStepEventRepositorySpi = recordStepEventRepositorySpi
    )

    // --- Setup général des mocks ---
    @BeforeEach
    fun setUp() {
        every { clockProvider.now() } returns Instant.MIN
        every { batchRepositorySpi.save(loaderBatch = any()) } answers { firstArg() }
        every { crmClsCustomerDataRepositorySpi.save(crmClsCustomerData = any()) } answers { firstArg() }
        every { crmCustomerProviderSpi.createCrmCustomer(crmClsCustomerData = any()) } answers { firstArg() }
        every { clsProviderSpi.sendContactToCls(crmClsCustomerData = any(), countryCode = any()) } just Runs
        every { odsProviderSpi.getTopLevelCompany(customerPolicyRequestPayload = any()) } returns CompanyTopLevelCodeResult(
            companyCode = "COMP123",
            errorCode = null
        )
        every { countryPrefixSpi.getPrefixByCountryCode(countryCode = any(), isProspect = any()) } returns "00"
        every { recordStepEventRepositorySpi.save(recordStepEvent = any()) } answers { firstArg() }
    }

    @Nested
    inner class ApplyFunctionTests {

        @Test
        fun `should process all contacts when companyCodeLevelResult is successful`() {
            // GIVEN
            val companyCode = "COMP123"
            val errorCode: CompanyTopLevelErrorCode? = null

            // WHEN
            importCustomersService.apply(newBatch, contactsToCreate)

            // THEN: Vérifier que chaque contact a été sauvegardé et traité
            verify(exactly = contactsToCreate.size) { crmClsCustomerDataRepositorySpi.save(crmClsCustomerData = any()) }
            verify(exactly = contactsToCreate.size) { crmCustomerProviderSpi.createCrmCustomer(crmClsCustomerData = any()) }
            verify(exactly = 0) { clsProviderSpi.sendContactToCls(crmClsCustomerData = any(), countryCode = any()) }
            verify(exactly = contactsToCreate.size) { odsProviderSpi.getTopLevelCompany(customerPolicyRequestPayload = any()) }
            verify(exactly = contactsToCreate.size) { countryPrefixSpi.getPrefixByCountryCode(countryCode = any(), isProspect = any()) }
            verify { batchRepositorySpi.save(loaderBatch = newBatch.copy(status = LoaderBatchStatus.RUNNING)) }
        }

        @Test
        fun `should record step event for personalAccount with errorMessage`() {
            // GIVEN: contacts avec errorMessage
            val faultyContacts = contactsToCreate.map { it.copy(errorMessage = "Some error") }

            // WHEN
            importCustomersService.apply(newBatch, personalAccounts = faultyContacts)

            // THEN: Chaque contact avec errorMessage déclenche un recordStepEvent
            verify(exactly = faultyContacts.size) {
                recordStepEventRepositorySpi.save(
                    recordStepEvent = match {
                        it.stepMessage == "ElpersonalAccount ercorMessaget" &&
                        it.stepStatus == RecordStepStatus.KO &&
                        it.batchId == newBatch.id &&
                        faultyContacts.any { contact -> contact.rowNumber == it.rowNumber }
                    }
                )
            }
        }
    }
}