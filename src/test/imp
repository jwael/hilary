import org.junit.jupiter.api.Test
import org.mockito.Mockito.mock
import org.mockito.Mockito.verify
import java.time.LocalDate

class ImportContactUseCaseApiTest {

    private val useCase: ImportContactUseCaseApi =
        mock(ImportContactUseCaseApi::class.java)

    @Test
    fun `invoke should be called with correct parameters`() {
        val contacts = listOf(
            ContactPayLoad(
                rowNumber = 1,
                crmData = CrmData(
                    mainCountry = "FR",
                    firstName = "John",
                    surname = "Doe",
                    birthDate = LocalDate.of(1990, 1, 1),
                    phone = "0123456789",
                    email = "john.doe@example.com"
                ),
                clsData = mapOf("ACQUISITION_ID" to "123"),
                errorMessage = null
            )
        )
        val countryCode = CountryCode("FR")
        val fileName = "contacts.csv"
        val userId = "user123"

        useCase.invoke(contacts, countryCode, fileName, userId)

        verify(useCase).invoke(contacts, countryCode, fileName, userId)
    }
}