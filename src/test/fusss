@Test
fun `should create CrmClsCustomerData from batch and payload`() {
    // GIVEN
    val personalAccount = contactsToCreate.first()
    every { referenceIdFactory.generate() } returns ReferenceId("REF123")
    every { clockProvider.now() } returns Instant.MIN

    // WHEN
    val crmClsCustomerData = importCustomersService.createCrmClsCustomerData(newBatch, personalAccount)

    // THEN
    assertEquals(newBatch.reference, crmClsCustomerData.reconciliationId.batchReference)
    assertEquals(ReferenceId("REF123"), crmClsCustomerData.reconciliationId.rowReference)
    assertEquals(personalAccount.rowNumber, crmClsCustomerData.rowNumber)
    assertEquals(personalAccount.crmData, crmClsCustomerData.crmData)
}

