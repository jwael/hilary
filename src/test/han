import org.junit.jupiter.api.Test
import org.mockito.Mockito.mock
import org.mockito.Mockito.verify
import java.time.Instant

class HandleClContactFeedbackUseCaseApiTest {

    private val useCase: HandLeClContactFeedbackUseCaseApi = mock(HandLeClContactFeedbackUseCaseApi::class.java)

    @Test
    fun `invoke should be called with correct ClsContactDataFeedbackPayLoad`() {
        val feedbackPayload = ClsContactDataFeedbackPayLoad(
            id = "FEEDBACK001",
            batchId = "BATCH001234", // 10 caractères
            reconciliationId = ReconciliationId(
                batchReference = ReferenceId("BATCH001234"),
                rowReference = ReferenceId("ROW0012345")
            ),
            rowNumber = 1,
            rowReference = ReferenceId("ROW0012345"),
            status = "SUCCESS",
            message = "Processed successfully",
            timestamp = Instant.now()
        )

        // appel de la fonction
        useCase.invoke(feedbackPayload)

        // vérification
        verify(useCase).invoke(feedbackPayload)
    }
}