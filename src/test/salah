private val contactsToCreate = IntStream.range(0, 2).mapToObj { i ->
    CustomerPayload(
        rowNumber = i,
        crmData = Instancio.of(CrmData::class.java)
            .set(CrmData::title, "Dr.")
            .set(CrmData::salutation, "Dr.")
            .set(CrmData::prefLanguageComm, "French")
            .set(CrmData::gender, "Male")
