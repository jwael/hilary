
import io.mockk.*
import io.mockk.impl.annotations.MockK
import org.junit.jupiter.api.*
import org.junit.jupiter.api.Assertions.*
import java.time.Instant
import java.util.stream.IntStream

class ImportCustomersServiceTest {

    @MockK
    private lateinit var referenceIdFactory: ReferenceIdFactory
    
    @MockK
    private lateinit var clockProvider: ClockProvider
    
    @MockK
    private lateinit var crmClsCustomerDataRepositorySpi: CrmClsCustomerDataRepositorySpi
    
    @MockK
    private lateinit var batchRepositorySpi: BatchRepositoryForContactsSpi
    
    @MockK
    private lateinit var crmCustomerProviderSpi: CrmCustomerProviderSpi
    
    @MockK
    private lateinit var recordStepEventRepositorySpi: RecordStepEventRepositorySpi

    private val batchReference = ReferenceId(value = "HVrA7jQziv")
    private val countryCodeUK = CountryCode(countryCode = "GB")
    private val fixedInstant = Instant.MIN
    private val rowReference = ReferenceId("REF1234567")

    private lateinit var importCustomersService: ImportCustomersService
    private lateinit var newBatch: LoaderBatch
    private lateinit var validContacts: List<CustomerPayload>

    @BeforeEach
    fun setup() {
        MockKAnnotations.init(this)
        
        every { clockProvider.now() } returns fixedInstant
        every { batchRepositorySpi.save(any()) } answers { firstArg() }
        every { crmClsCustomerDataRepositorySpi.save(any()) } answers { firstArg() }
        every { recordStepEventRepositorySpi.save(any()) } answers { firstArg() }
        every { referenceIdFactory.generate() } returns rowReference

        // Configurations CRM par défaut
        every { crmCustomerProviderSpi.createCrmCustomer(any()) } returns CrmCustomerResponsePayload(
            crmAccountId = "CRM123", 
            crmStatus = RecordStepStatus.OK
        )
        every { crmCustomerProviderSpi.updateCrmCustomer(any()) } returns CrmCustomerResponsePayload(
            crmAccountId = "CRM123", 
            crmStatus = RecordStepStatus.OK
        )
        every { crmCustomerProviderSpi.createCrmRole(any()) } returns CrmRoleResponsePayload(
            crmRoleId = "ROLE123", 
            crmStatus = RecordStepStatus.OK
        )
        every { crmCustomerProviderSpi.updateCrmRole(any()) } returns CrmRoleResponsePayload(
            crmRoleId = "ROLE123", 
            crmStatus = RecordStepStatus.OK
        )

        validContacts = IntStream.range(0, 3).mapToObj { index ->
            CustomerPayload(
                rowNumber = index,
                crmData = CrmData(
                    title = "Dr.",
                    salutation = "Dr.",
                    prefLanguageComm = "French",
                    gender = "Male",
                    contactRole = "Driver",
                    country = "GB",
                    mainCountry = "GB"
                ),
                clsData = mapOf("existingKey" to "existingValue"),
                errorMessage = null
            )
        }.toList()

        newBatch = LoaderBatch(
            id = "AAAAA",
            reference = batchReference,
            fileName = "a-file-name.csv",
            triggeredBy = "u00001",
            countryCode = countryCodeUK,
            status = LoaderBatchStatus.RUNNING,
            startDate = fixedInstant,
            endDate = fixedInstant,
            totalContacts = validContacts.size,
            type = LoaderBatchType.CONTACTS
        )

        importCustomersService = ImportCustomersService(
            recordStepEventRepositorySpi = recordStepEventRepositorySpi,
            clockProvider = clockProvider,
            referenceIdFactory = referenceIdFactory,
            crmClsCustomerDataRepositorySpi = crmClsCustomerDataRepositorySpi,
            crmCustomerProviderSpi = crmCustomerProviderSpi,
            batchRepositorySpi = batchRepositorySpi
        )
    }

    @Nested
    inner class ApplyMethodAllPathsTests {

        @Test
        fun `should process customer creation when no special conditions`() {
            // GIVEN: CustomerData sans conditions spéciales
            val customerData = mockk<CrmClsCustomerData> {
                every { isCreateRole() } returns false
                every { isUpdateRole() } returns false
                every { isCrmUpdate() } returns false
                every { batchId } returns "BATCH123"
                every { rowNumber } returns 1
                every { reconciliationId } returns ReconciliationId(batchReference, rowReference)
            }
            every { crmClsCustomerDataRepositorySpi.save(any()) } returns customerData

            // WHEN
            importCustomersService.apply(newBatch, listOf(validContacts.first()))

            // THEN: Doit appeler createCrmCustomer
            verify(exactly = 1) { crmCustomerProviderSpi.createCrmCustomer(any()) }
            verify(exactly = 0) { crmCustomerProviderSpi.updateCrmCustomer(any()) }
            verify(exactly = 0) { crmCustomerProviderSpi.createCrmRole(any()) }
            verify(exactly = 0) { crmCustomerProviderSpi.updateCrmRole(any()) }
        }

        @Test
        fun `should process role creation when isCreateRole is true`() {
            // GIVEN: CustomerData avec création de rôle
            val customerData = mockk<CrmClsCustomerData> {
                every { isCreateRole() } returns true
                every { isUpdateRole() } returns false
                every { isCrmUpdate() } returns false
                every { batchId } returns "BATCH123"
                every { rowNumber } returns 1
                every { reconciliationId } returns ReconciliationId(batchReference, rowReference)
                every { crmData } returns CrmData(title = "Dr.")
            }
            every { crmClsCustomerDataRepositorySpi.save(any()) } returns customerData

            // WHEN
            importCustomersService.apply(newBatch, listOf(validContacts.first()))

            // THEN: Doit appeler createCrmRole
            verify(exactly = 0) { crmCustomerProviderSpi.createCrmCustomer(any()) }
            verify(exactly = 1) { crmCustomerProviderSpi.createCrmRole(any()) }
        }

        @Test
        fun `should process role update when isUpdateRole is true`() {
            // GIVEN: CustomerData avec mise à jour de rôle
            val customerData = mockk<CrmClsCustomerData> {
                every { isCreateRole() } returns false
                every { isUpdateRole() } returns true
                every { isCrmUpdate() } returns false
                every { batchId } returns "BATCH123"
                every { rowNumber } returns 1
                every { reconciliationId } returns ReconciliationId(batchReference, rowReference)
                every { crmData } returns CrmData(title = "Dr.")
            }
            every { crmClsCustomerDataRepositorySpi.save(any()) } returns customerData

            // WHEN
            importCustomersService.apply(newBatch, listOf(validContacts.first()))

            // THEN: Doit appeler updateCrmRole
            verify(exactly = 0) { crmCustomerProviderSpi.createCrmCustomer(any()) }
            verify(exactly = 1) { crmCustomerProviderSpi.updateCrmRole(any()) }
        }

        @Test
        fun `should process customer update when isCrmUpdate is true`() {
            // GIVEN: CustomerData avec mise à jour CRM
            val customerData = mockk<CrmClsCustomerData> {
                every { isCreateRole() } returns false
                every { isUpdateRole() } returns false
                every { isCrmUpdate() } returns true
                every { batchId } returns "BATCH123"
                every { rowNumber } returns 1
                every { reconciliationId } returns ReconciliationId(batchReference, rowReference)
            }
            every { crmClsCustomerDataRepositorySpi.save(any()) } returns customerData

            // WHEN
            importCustomersService.apply(newBatch, listOf(validContacts.first()))

            // THEN: Doit appeler updateCrmCustomer
            verify(exactly = 0) { crmCustomerProviderSpi.createCrmCustomer(any()) }
            verify(exactly = 1) { crmCustomerProviderSpi.updateCrmCustomer(any()) }
        }
    }

    @Nested
    inner class ProcessCustomerCreationInCrmStepTests {

        @Test
        fun `should create customer and record SF_CREATE event`() {
            // GIVEN
            val customerData = validContacts.first().toCrmClsCustomerData()
            val crmResponse = CrmCustomerResponsePayload(
                crmAccountId = "CRM_ACCOUNT_123",
                crmStatus = RecordStepStatus.OK,
                message = "Customer created successfully"
            )
            every { crmCustomerProviderSpi.createCrmCustomer(any()) } returns crmResponse

            // WHEN
            importCustomersService.processCustomerCreationInCrmStep(customerData)

            // THEN
            verify(exactly = 1) { crmCustomerProviderSpi.createCrmCustomer(customerData) }
            verify(exactly = 1) { 
                crmClsCustomerDataRepositorySpi.save(
                    match { savedData ->
                        savedData.crmInsertedId == "CRM_ACCOUNT_123" &&
                        savedData.clsData["SALESFORCE_ROLE_ID"] == "CRM_ACCOUNT_123"
                    }
                ) 
            }
            verify(exactly = 1) {
                recordStepEventRepositorySpi.save(
                    match { event ->
                        event.stepName == "SF_CREATE" &&
                        event.stepStatus == RecordStepStatus.OK &&
                        event.stepMessage == "Customer created successfully" &&
                        event.batchId == customerData.batchId
                    }
                )
            }
        }
    }

