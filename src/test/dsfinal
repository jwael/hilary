    @Nested
    inner class ErrorHandlingTests {

        @Test
        fun `should handle exception in apply and record KO event`() {
            // GIVEN: Simulation d'une exception
            every { crmClsCustomerDataRepositorySpi.save(any()) } throws RuntimeException("Database error")

            // WHEN
            importCustomersService.apply(newBatch, listOf(validContacts.first()))

            // THEN: Doit enregistrer un événement KO
            verify(exactly = 1) {
                recordStepEventRepositorySpi.save(
                    match { event ->
                        event.stepStatus == RecordStepStatus.KO &&
                        event.stepName == "BLM" &&
                        event.stepMessage == "Database error"
                    }
                )
            }
        }

        @Test
        fun `should handle CRM operation failure and record appropriate status`() {
            // GIVEN: CRM qui retourne KO
            val customerData = mockk<CrmClsCustomerData> {
                every { isCreateRole() } returns false
                every { isUpdateRole() } returns false
                every { isCrmUpdate() } returns false
                every { batchId } returns "BATCH123"
                every { rowNumber } returns 1
                every { reconciliationId } returns ReconciliationId(batchReference, rowReference)
            }
            every { crmClsCustomerDataRepositorySpi.save(any()) } returns customerData
            every { crmCustomerProviderSpi.createCrmCustomer(any()) } returns CrmCustomerResponsePayload(
                crmAccountId = null,
                crmStatus = RecordStepStatus.KO,
                message = "CRM creation failed"
            )

            // WHEN
            importCustomersService.apply(newBatch, listOf(validContacts.first()))

            // THEN: Doit enregistrer un événement SF_CREATE en KO
            verify(exactly = 1) {
                recordStepEventRepositorySpi.save(
                    match { event ->
                        event.stepName == "SF_CREATE" &&
                        event.stepStatus == RecordStepStatus.KO
                    }
                )
            }
        }
    }

    private fun CustomerPayload.toCrmClsCustomerData(): CrmClsCustomerData {
        return CrmClsCustomerData(
            batchId = newBatch.id!!,
            reconciliationId = ReconciliationId(batchReference, rowReference),
            rowNumber = rowNumber,
            rowReference = rowReference,
            crmData = crmData,
            clsData = clsData,
            crmInsertedId = null
        )
    }
}