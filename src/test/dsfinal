    @Nested
    inner class ProcessRoleUpdateInCrmStepTests {

        @Test
        fun `should update role and record SF_UPDATE_ROLE event`() {
            // GIVEN
            val customerData = validContacts.first().toCrmClsCustomerData()
            val crmRoleResponse = CrmRoleResponsePayload(
                crmRoleId = "CRM_ROLE_456",
                crmStatus = RecordStepStatus.OK,
                message = "Role updated successfully"
            )
            every { crmCustomerProviderSpi.updateCrmRole(any()) } returns crmRoleResponse

            // WHEN
            importCustomersService.processRoleUpdateInCrmStep(customerData)

            // THEN
            verify(exactly = 1) { 
                crmCustomerProviderSpi.updateCrmRole(
                    match { roleData ->
                        roleData.batchId == customerData.batchId
                    }
                ) 
            }
            verify(exactly = 1) {
                recordStepEventRepositorySpi.save(
                    match { event ->
                        event.stepName == "SF_UPDATE_ROLE" &&
                        event.stepStatus == RecordStepStatus.OK &&
                        event.stepMessage == "Role updated successfully"
                    }
                )
            }
            // Note: pour update role, on ne sauvegarde pas le customer data
            verify(exactly = 0) { crmClsCustomerDataRepositorySpi.save(customerData) }
        }
    }

    @Nested
    inner class CreateCrmClsCustomerDataTests {

        @Test
        fun `should create CrmClsCustomerData with valid data`() {
            // GIVEN
            val personalAccount = validContacts.first()
            val loaderBatch = newBatch.copy(id = "BATCH123")

            // WHEN
            val result = importCustomersService.createCrmClsCustomerData(loaderBatch, personalAccount)

            // THEN
            assertEquals("BATCH123", result.batchId)
            assertEquals(personalAccount.rowNumber, result.rowNumber)
            assertEquals(rowReference, result.rowReference)
            assertEquals(personalAccount.crmData, result.crmData)
            assertEquals(personalAccount.clsData, result.clsData)
            assertNull(result.crmInsertedId)
        }
    }

    @Nested
    inner class UpdateCrmClsDataWithCrmResponseTests {

        @Test
        fun `should update with CRM account ID and add to clsData`() {
            // GIVEN
            val originalData = validContacts.first().toCrmClsCustomerData()
            val crmResponse = CrmCustomerResponsePayload(crmAccountId = "CRM123", crmStatus = RecordStepStatus.OK)

            // WHEN
            val result = importCustomersService.updateCrmClsDataWithCrmResponse(originalData, crmResponse)

            // THEN
            assertEquals("CRM123", result.crmInsertedId)
            assertEquals("CRM123", result.clsData["SALESFORCE_ROLE_ID"])
        }
